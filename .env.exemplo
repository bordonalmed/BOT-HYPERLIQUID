# Configuracao local do bot. NUNCA envie este arquivo para ninguem (nem para o Claude).
# Copie para ".env" (o 16_configurar_env.bat faz isso) e preencha.

# MODO: paper (simulacao, padrao), testnet (dinheiro de teste) ou real (dinheiro de verdade)
MODO=paper

# Endereco 0x... da sua carteira PRINCIPAL (a que voce conecta no site da Hyperliquid)
HL_ACCOUNT_ADDRESS=

# Chave privada da API WALLET (site > More > API > Generate). NUNCA a chave da carteira principal.
# A API Wallet pode operar, mas nao pode sacar. Para a testnet, crie a API Wallet no site da testnet.
HL_SECRET_KEY=

# Para MODO=real e obrigatorio descomentar a linha abaixo (confirmacao explicita):
# CONFIRMO_DINHEIRO_REAL=SIM
